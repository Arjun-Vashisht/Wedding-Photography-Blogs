# Copy this file to .env and fill in your values. Never commit .env (it holds your keys and password).

# --- Language model (free) ---
#   groq   (default) free key, no card: https://console.groq.com/keys
#   gemini           free key:          https://aistudio.google.com/apikey
#   ollama           runs on your computer, no key needed: https://ollama.com
LLM_PROVIDER=groq
LLM_API_KEY=

# --- Admin page (http://localhost:8000/admin/) ---
# Drafts wait for your approval there. Leave the password empty and one is created on first start.
ADMIN_PASSWORD=
REQUIRE_APPROVAL=true
DRAFTS_PER_DAY=3
# DRAFTS_TIME=06:00

# --- Photos ---
# Works with no key (Openverse, free Creative Commons photos). Optional keys give more choice.
PIXABAY_API_KEY=
PEXELS_API_KEY=

# --- Reel voiceover (Kokoro, free and offline) ---
# Female voices: hf_alpha (Indian, default), hf_beta (Indian, softer), af_heart, af_bella (American),
# bf_emma, bf_isabella (British). Set VOICEOVER=false to turn narration off.
VOICEOVER=true
VOICE=hf_alpha
# VOICE_SPEED=1.0

# --- Website ---
# Your real address once the site is online (used in canonical URLs, sitemap and social cards).
SITE_URL=http://localhost:8000
# SITE_NAME=Phera

# --- Optional overrides ---
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FAST_MODEL=openai/gpt-oss-20b
# INDIA_SHARE=0.70
# MORNING_TIME=07:00
# EVENING_TIME=19:00
